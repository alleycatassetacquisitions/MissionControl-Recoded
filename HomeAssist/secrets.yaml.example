# Mission Control — secrets example
#
# Copy this file to config/secrets.yaml on your HA instance and fill in real values.
# Never commit the real secrets.yaml to version control.
#
# ─────────────────────────────────────────────────────────────────────────────
# Core Configurator
# ─────────────────────────────────────────────────────────────────────────────
#
# These seed Core Configurator on first boot. After the config entry exists,
# edit URLs and tokens from the Core Configurator sidebar — the YAML block is ignored.

# ─── Master Control Server ───────────────────────────────────────────────────
# From Docs/install-mcs-proxmox.sh Done output (URL + generated token).
cc_master_control_server: http://192.168.1.10:8700
cc_master_control_server_token: replace-with-mcs-api-token

# Central Server URLs — set once here; Registration pushes them to MCS on every
# HA start and whenever you change them in the Core Configurator sidebar.
# Secondary is optional — use "" when there is no LAN mirror (do not leave a
# dead IP; MCS treats empty secondary as cleared).
cc_central_primary: https://your-cloud-player-api.example.com
cc_central_secondary: ""

# ─── Other services ──────────────────────────────────────────────────────────
# AlleycatTV content server — from Docs/install-alleycattv-proxmox.sh Done output.
cc_alleycattv: http://192.168.1.100
cc_gbn: http://10.10.50.187:8100
cc_proxmox: https://192.168.1.1:8006
cc_proxmox_node: pve
# Same Proxmox API token used in HA Core Proxmox VE (monitoring) and Bug Buster (console).
cc_proxmox_token_id: hass@pve!missioncontrol
cc_proxmox_token_secret: replace-with-proxmox-token-secret

# Live RTSP interrupt for AlleycatTV (camera/encoder — not the content server).
cc_rtsp: rtsp://192.168.1.50:554/stream1
cc_rtsp_label: Live RTSP
cc_rtsp_enabled: false

# Net Time — from install-net-time-proxmox.sh Done output (URL + token).
cc_net_time: http://10.10.50.203:8720
cc_net_time_token: replace-with-net-time-api-token

# Venue update agent — from install-mission-control.sh (Proxmox host :8722).
cc_venue_updater: http://192.168.1.1:8722
cc_venue_updater_token: replace-with-venue-updater-token
