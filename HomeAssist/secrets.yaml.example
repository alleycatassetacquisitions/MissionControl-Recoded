# Mission Control — secrets example
#
# Copy this file to config/secrets.yaml on your HA instance and fill in real values.
# Never commit the real secrets.yaml to version control.
#
# ─────────────────────────────────────────────────────────────────────────────
# Phase 1 — Core Configurator
# ─────────────────────────────────────────────────────────────────────────────
#
# These seed Core Configurator on first boot. After the config entry exists,
# edit URLs from the Core Configurator sidebar — the YAML block is ignored.

cc_registration_primary: https://your-cloud-player-api.example.com
cc_registration_secondary: http://192.168.1.234:8090
cc_alleycattv: http://headless-alleycat-streaming-server.local
cc_gbn: http://192.168.1.206:8100
cc_proxmox: https://192.168.1.1:8006
cc_proxmox_node: pve
